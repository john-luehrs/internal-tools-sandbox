# OpenAI API key — required for real AI features
# Leave blank to use mock AI responses (all tools work without this)
OPENAI_API_KEY=

# AI model to use (default: gpt-4o-mini for cost efficiency)
OPENAI_MODEL=gpt-4o-mini

# Mock API server base URL
API_BASE_URL=http://localhost:8000

# Environment: development | production
ENV=development
